# JourneyX AI — Credentials Template
# Copy this file to credentials.local.yaml and fill in your API keys.
# NEVER commit credentials.local.yaml to version control.

chat:
  api_base: https://<CAPSTONE_VM_IP>:1033/v1
  api_key: sk-<YOUR_CHAT_API_KEY>
  model: Qwen/Qwen3-8B
  ca_cert: certs/vm05-ca.crt
  max_tokens: 1024

embeddings:
  api_base: https://<CAPSTONE_VM_IP>:1035/v1
  api_key: sk-<YOUR_EMBEDDINGS_API_KEY>
  model: bge-small-en-v1.5
  ca_cert: certs/vm02-ca.crt